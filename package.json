{
  "name": "turno",
  "version": "0.2.0",
  "private": true,
  "description": "Desktop app to schedule and run AI agent routines on your PC (Claude Code or local models via Ollama), with split terminals and a live chat with the running agent.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "smoke": "electron-vite build && electron . --smoke",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "node-pty"
    ]
  },
  "dependencies": {
    "croner": "^10.0.1",
    "node-pty": "1.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "dockview-react": "8.6.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "~5.9.3",
    "vite": "8.3.4"
  },
  "author": "Rafael de Carvalho",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eurafaeldecarvalho/turno.git"
  },
  "homepage": "https://github.com/eurafaeldecarvalho/turno#readme",
  "keywords": [
    "ai-agents",
    "claude-code",
    "ollama",
    "scheduler",
    "electron",
    "terminal"
  ]
}